{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-worker",
  "compatibility_date": "2026-09-01",
  // wrangler does not build on its own; without this, deploy fails on a fresh checkout because ./out is missing
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
